# Copy to .env and fill in. The app, the CDK app and scripts/cdk.sh all read .env; a value
# already set in the shell wins over the file. Defaults for everything except AWS_PROFILE
# live in src/crewops/config.py, so a line can be left out to use its default.
# Never put AWS access keys here: they belong in ~/.aws, set up with `aws configure --profile`.

# -- AWS ---------------------------------------------------------------------------------
# AWS CLI profile to deploy and run with. Required; "default" is refused.
AWS_PROFILE=crewops
# Region for every AWS resource.
AWS_REGION=ap-southeast-2
# Deployment stage. All AWS resource names are derived from it (crewops-<stage>-...).
CREWOPS_STAGE=dev

# -- NVIDIA Nemotron on Nebius Token Factory ---------------------------------------------
# API key for local runs (ask --live, evaluate --live, python -m crewops.agent.nebius).
# The deployed services never read this: they read the SecureString
# /crewops-<stage>/nebius/api-key from Parameter Store (see README).
NEBIUS_API_KEY=
# Token Factory's OpenAI-compatible API.
CREWOPS_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Chat models for the three roles: Token Factory model ids, not Bedrock ids.
# Check what your key can use with: uv run python -m crewops.agent.nebius
CREWOPS_ROUTER_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
CREWOPS_ADVISOR_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
CREWOPS_EXPLAINER_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# -- Search embeddings (Amazon Bedrock) ----------------------------------------------------
CREWOPS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# 256, 512 or 1024; must match the dimensions the search indexes were built with.
CREWOPS_EMBEDDING_DIMENSIONS=512

# -- Bedrock Guardrails (after deploying the guardrail stack) -----------------------------
# The stack's GuardrailId and GuardrailVersionNumber outputs. Leave both empty for none.
# The version must be a published number, never DRAFT.
CREWOPS_GUARDRAIL_ID=
CREWOPS_GUARDRAIL_VERSION=

# -- Answer pipeline ----------------------------------------------------------------------
CREWOPS_MAX_TOOL_ITERATIONS=8
CREWOPS_RESPONSE_BUDGET_SECONDS=6.0
# Set from `uv run python -m crewops.agent.calibrate`; leave empty for the default (0.45).
CREWOPS_ROUTER_SEMANTIC_FLOOR=

# -- Optional ----------------------------------------------------------------------------
# IAM user or role ARNs, besides the MCP server, allowed to send reports to the ingest queue
# (comma-separated), e.g. your own IAM user for `python -m crewops.ingestion.send_report`.
CREWOPS_QUEUE_SENDERS=
# Minutes a disruption may wait untouched on a desk before the duty supervisor is alerted.
CREWOPS_ESCALATE_AFTER_MINUTES=10

# -- Alexa skill (only if you deploy it) --------------------------------------------------
# From the Alexa developer console: the skill id, and the three Account Linking redirect
# URLs, comma-separated.
CREWOPS_ALEXA_SKILL_ID=
CREWOPS_ALEXA_REDIRECT_URLS=
# development until the skill is certified, then live.
CREWOPS_ALEXA_EVENTS_STAGE=development
